{
    "i18n": true,
    "type": "panel",
    "items": {
        "_server": {
            "type": "header",
            "text": "Web server",
            "size": 3
        },
        "bind": {
            "type": "ip",
            "label": "IP address",
            "listenOnAllPorts": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "port": {
            "type": "port",
            "label": "Port",
            "min": 1,
            "max": 65535,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_discovery": {
            "type": "header",
            "text": "Automatic discovery",
            "size": 3,
            "newLine": true
        },
        "language": {
            "type": "select",
            "label": "Language",
            "help": "User interface and generated device names",
            "options": [
                {
                    "label": "System language",
                    "value": ""
                },
                {
                    "label": "Deutsch",
                    "value": "de"
                },
                {
                    "label": "English",
                    "value": "en"
                }
            ],
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "rediscoverDelay": {
            "type": "number",
            "label": "Rediscovery after object change (seconds)",
            "min": 1,
            "max": 3600,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "ignoreAdapters": {
            "type": "text",
            "label": "Ignored adapters (comma-separated)",
            "help": "These adapters are skipped during discovery",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "_ui": {
            "type": "header",
            "text": "User interface",
            "size": 3,
            "newLine": true
        },
        "allowEdit": {
            "type": "checkbox",
            "label": "Allow edit mode",
            "help": "Rename, hide, move and mark favourites in the app. As long as there is no login, anyone on the network can save customisations.",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        }
    }
}
